# ============================================================
# Microsoft Teams – Azure AD App Registration
# ============================================================
# Crie um App Registration em: https://portal.azure.com
# > Azure Active Directory > App registrations > New registration
#
# Permissões necessárias (Microsoft Graph – Delegated):
#   - OnlineMeetings.Read
#   - OnlineMeetingTranscript.Read.All
#   - CallRecords.Read.All  (opcional, para metadados de chamadas)
#
# Em "Authentication" adicione: http://localhost:8080 como Redirect URI (Mobile/Desktop)
TEAMS_CLIENT_ID=seu-client-id-aqui
TEAMS_TENANT_ID=seu-tenant-id-aqui
# Deixe vazio para usar Device Code Flow (recomendado quando não é admin)
TEAMS_CLIENT_SECRET=

# ID de uma reunião Teams para testar (formato: base64url longo)
# Obtenha via: GET /me/onlineMeetings
TEAMS_MEETING_ID=

# ============================================================
# tl;dv
# ============================================================
# Plano FREE: a API pública é limitada — o script verifica o que está disponível
# Obtenha em: https://app.tldv.io/settings/api  (se disponível no seu plano)
TLDV_API_KEY=seu-api-key-aqui
